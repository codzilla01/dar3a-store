# ============================================================
# Dar3a Store — متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env وضع القيم الحقيقية فيه.
# NEVER commit the real .env file.
# ============================================================

# ---------- Supabase (مطلوب) ----------
# Project URL من: Supabase Dashboard > Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# مفتاح anon/public (يستعمله الخادم للقراءة والكتابة حسب RLS)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# (اختياري — يفضَّل للخادم) service_role key للوصول الكامل
SUPABASE_SERVICE_KEY=

# ---------- المصادقة (مطلوب) ----------
# مفتاح توقيع JWT — ولّد واحداً قوياً: openssl rand -hex 32
ADMIN_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ---------- Telegram (مطلوب لدخول الإدارة عبر OTP) ----------
# توكن البوت من @BotFather — احتفظ به سرياً (لا يوضع في الكود أبداً)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# (اختياري) بوت ودردشة خاص بدور "المساعد"
TELEGRAM_ASSISTANT_TOKEN=
TELEGRAM_ASSISTANT_CHAT_ID=

# ---------- الخادم المحلي (اختياري) ----------
PORT=3000
