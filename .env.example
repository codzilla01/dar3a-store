# ============================================================
# Dar3a Store — Production environment variables
# Copy to .env for local use. Never commit the real .env.
# ============================================================

# Supabase — server only. Production requires the service_role key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Authentication — required, at least 32 random characters.
# Generate: openssl rand -hex 32
ADMIN_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Runtime
NODE_ENV=production
PORT=3000

# Annual license enforcement for the deployed customer store.
# Set REQUIRE_STORE_LICENSE=true only after creating and activating the client
# subscription in developer.html. The storefront API is blocked if it expires.
REQUIRE_STORE_LICENSE=true
STORE_ACTIVATION_KEY=
STORE_LICENSE_DOMAIN=

# Local UI demonstration only. Never enable this in Vercel/production.
# ALLOW_DEMO_MODE=true
# DEMO_DEVELOPER_USERNAME=demo-admin
# DEMO_DEVELOPER_PASSWORD=ChangeThisDemoPassword123!

# First production login (run locally after executing supabase/schema.sql):
# npm run bootstrap-developer -- developer 'A-long-unique-password-123' 'Store Developer'
